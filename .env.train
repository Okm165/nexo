# sample definition (changing these requires `newsimpact build`)
WINDOW=5
SAMPLE_START=2021-01-01
# walk-forward evaluation: fold k validates on the period starting at date k,
# tests on the next one, and trains on everything before date k
FOLDS=2022-01-01,2023-01-01,2024-01-01,2025-01-01,2026-01-01
